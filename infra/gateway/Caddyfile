{
  admin off
  auto_https off
  # Only the tunnel connector and other Compose peers may assert a client
  # address; Cloudflare overwrites CF-Connecting-IP at its edge.
  servers {
    trusted_proxies static private_ranges
    client_ip_headers CF-Connecting-IP
  }
}

# Defines the `web` upstream: the packaged server, or Vite in the development stack.
import /etc/caddy/web.caddy

:8080 {
  header Cache-Control "no-store"
  handle /setup* {
    reverse_proxy owner-setup:8080
  }
  handle /health/* {
    reverse_proxy api:8080
  }
  handle /api/v1/* {
    # API throttles key on the last X-Forwarded-For entry; send exactly one.
    reverse_proxy api:8080 {
      header_up X-Forwarded-For {client_ip}
    }
  }
  # Auth health is public; sign-in/callbacks run through the web server.
  handle /auth/v1/health {
    reverse_proxy supabase-gateway:8000
  }
  @emailFallback {
    method GET
    path /auth/v1/verify
  }
  handle @emailFallback {
    import web
  }
  @private path /auth/v1 /auth/v1/* /rest/v1 /rest/v1/* /storage/v1 /storage/v1/* /pg/*
  handle @private {
    respond "Not found" 404
  }
  # Public forms run on no session: staff cookies never reach their renderer.
  handle /f/* {
    request_header -Cookie
    import web
  }
  # Published content is the same: its renderer never sees a staff session.
  handle /c/* {
    request_header -Cookie
    import web
  }
  handle {
    import web
  }
}
