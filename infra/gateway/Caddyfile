{
  admin off
  auto_https off
}

:8080 {
  header Cache-Control "no-store"
  handle /health/* {
    reverse_proxy api:8080
  }
  handle /api/v1/* {
    reverse_proxy api:8080
  }
  # Only Auth health is public until the sign-in/callback security slice is built.
  handle /auth/v1/health {
    reverse_proxy supabase-gateway:8000
  }
  @private path /auth/v1 /auth/v1/* /rest/v1 /rest/v1/* /storage/v1 /storage/v1/* /pg/*
  handle @private {
    respond "Not found" 404
  }
  handle {
    reverse_proxy web:3000
  }
}
