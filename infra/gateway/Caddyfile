{
  admin off
  auto_https off
  # Only the tunnel connector and other Compose peers may assert a client
  # address; Cloudflare overwrites CF-Connecting-IP at its edge.
  servers {
    trusted_proxies static private_ranges
    client_ip_headers CF-Connecting-IP
  }
}

:8080 {
  header Cache-Control "no-store"
  handle /health/* {
    reverse_proxy api:8080
  }
  handle /api/v1/* {
    # API throttles key on the last X-Forwarded-For entry; send exactly one.
    reverse_proxy api:8080 {
      header_up X-Forwarded-For {client_ip}
    }
  }
  # Auth health is public; sign-in/callbacks run through the web server.
  handle /auth/v1/health {
    reverse_proxy supabase-gateway:8000
  }
  @emailFallback {
    method GET
    path /auth/v1/verify
  }
  handle @emailFallback {
    reverse_proxy web:3000
  }
  @private path /auth/v1 /auth/v1/* /rest/v1 /rest/v1/* /storage/v1 /storage/v1/* /pg/*
  handle @private {
    respond "Not found" 404
  }
  handle {
    reverse_proxy web:3000
  }
}
