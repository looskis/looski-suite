# Copying this is optional: python3 scripts/dev.py configure creates .env safely.
COMPOSE_PROJECT_NAME=looski-suite
LOOSKI_HTTP_PORT=58888
LOOSKI_PUBLIC_URL=http://localhost:58888
# This scaffold supports local Supabase only; hosted mode is a later overlay.
# disabled (default), local (private development inbox), or smtp (private credentials).
LOOSKI_MAIL_MODE=disabled
# Configure a private OAuth client first; see docs/auth-google.md.
LOOSKI_GOOGLE_AUTH_ENABLED=false

# Local ClickHouse diagnostics (lossy; independent of business audit).
LOOSKI_DIAGNOSTICS_MODE=local
