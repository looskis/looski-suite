{
  "name": "looski-suite",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "pnpm --filter @looski/web dev",
    "build": "pnpm --filter @looski/web build",
    "check": "pnpm --filter @looski/web check",
    "format": "prettier --write apps/web package.json pnpm-workspace.yaml .prettierrc.json",
    "format:check": "prettier --check apps/web package.json pnpm-workspace.yaml .prettierrc.json",
    "api:generate": "python3 scripts/contracts.py",
    "api:check": "python3 scripts/contracts.py --check"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "5.9.3"
  }
}
